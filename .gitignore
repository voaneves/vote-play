brand/palette.json

# Saídas de ferramentas externas (capturas, exportações, arquivos temporários).
# O glob cobre tanto "outputs/" quanto pastas que a ferramenta nomeia com um
# prefixo próprio — um app de desktop já despejou um arquivo dentro do repo
# assim, e uma regra que não casa com o nome real não ignora nada.
*outputs/
*.tmp.pdf

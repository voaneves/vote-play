# Provider de dados: 'mock' (em memória, sem backend) ou 'supabase'.
# Fase 0/1 do plan.md rodam com 'mock'.
VITE_API_PROVIDER=mock

# Preenchidos a partir da Fase 1. Ambos são PÚBLICOS por design:
# o bundle do GitHub Pages é estático, então a segurança fica na RLS do Postgres.
# A chave service_role NUNCA entra aqui — ela vive só nas Edge Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
